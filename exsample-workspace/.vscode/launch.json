{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Test Program",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "args": [],
            "stopAtEntry": true,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "build-debug"
        },
        {
            "name": "Launch Extension Host for CRD Testing",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/..",
                "${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/../out/**/*.js"
            ],
            "preLaunchTask": "npm: compile"
        }
    ]
}